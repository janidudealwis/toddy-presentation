{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__vpath=/api/$1" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
